###############################################################################
# SUKHAVASAM HMS - Environment Template
###############################################################################

########################
# Django
########################

DJANGO_ENV=development
DEBUG=True

SECRET_KEY=change-me

ALLOWED_HOSTS=localhost,127.0.0.1

TIME_ZONE=Asia/Kolkata

LANGUAGE_CODE=en-in


########################
# Database
########################

DATABASE_URL=postgres://username:password@localhost:5432/hms


########################
# Redis
########################

REDIS_URL=redis://127.0.0.1:6379/0


########################
# Celery
########################

CELERY_BROKER_URL=${REDIS_URL}

CELERY_RESULT_BACKEND=${REDIS_URL}


########################
# Email
########################

EMAIL_HOST=

EMAIL_PORT=587

EMAIL_HOST_USER=

EMAIL_HOST_PASSWORD=

EMAIL_USE_TLS=True

DEFAULT_FROM_EMAIL=


########################
# Storage
########################

MEDIA_STORAGE=local

MEDIA_URL=/media/

STATIC_URL=/static/


########################
# Cloudinary (Future)
########################

CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=


########################
# Razorpay
########################

RAZORPAY_KEY_ID=

RAZORPAY_KEY_SECRET=


########################
# SMS
########################

SMS_PROVIDER=

SMS_API_KEY=


########################
# WhatsApp
########################

WHATSAPP_ACCESS_TOKEN=


########################
# AI
########################

OPENAI_API_KEY=


########################
# Logging
########################

LOG_LEVEL=INFO